#!/usr/bin/env bash
#
# dev-setup — provision the shared dev toolchain on macOS, no Homebrew / no sudo.
# Everything lands under ~/.local so it's reusable across every project; per-project
# dependencies (venvs, node_modules) are NOT this script's job — run each project's
# own `make install` / `make venv` for those.
#
# Installs / updates:
#   - uv          -> ~/.local/bin           (Astral's Python & venv manager)
#   - Python      -> managed by uv          (default: 3.12)
#   - Node LTS    -> ~/.local/node-vXX.Y.Z, symlinked into ~/.local/bin
#
# Usage:
#   dev-setup                 # install uv + Python 3.12 + Node 22
#   PYTHON_VERSION=3.13 dev-setup
#   NODE_MAJOR=24 dev-setup
#
set -euo pipefail

LOCAL_BIN="$HOME/.local/bin"
PYTHON_VERSION="${PYTHON_VERSION:-3.12}"
NODE_MAJOR="${NODE_MAJOR:-22}"
NODE_FALLBACK="${NODE_FALLBACK:-v22.22.3}"   # used only if the dist index is unreachable

mkdir -p "$LOCAL_BIN"

say()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m  ✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m  ! \033[0m%s\n' "$*"; }

case "$(uname -m)" in
  arm64)  NODE_ARCH="arm64" ;;
  x86_64) NODE_ARCH="x64" ;;
  *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

# ── uv ─────────────────────────────────────────────────────────────────────────
say "uv"
if [ -x "$LOCAL_BIN/uv" ] || command -v uv >/dev/null 2>&1; then
  ok "present ($(uv --version 2>/dev/null || "$LOCAL_BIN/uv" --version))"
else
  curl -LsSf https://astral.sh/uv/install.sh | sh
  ok "installed"
fi
export PATH="$LOCAL_BIN:$PATH"

# ── Python (managed by uv) ─────────────────────────────────────────────────────
say "Python $PYTHON_VERSION"
uv python install "$PYTHON_VERSION"
ok "available ($(uv python find "$PYTHON_VERSION" 2>/dev/null || echo "$PYTHON_VERSION"))"

# ── Node LTS ───────────────────────────────────────────────────────────────────
say "Node $NODE_MAJOR.x"
if command -v node >/dev/null 2>&1 && \
   [ "$(node --version | cut -d. -f1)" = "v$NODE_MAJOR" ]; then
  ok "present ($(node --version))"
else
  NODE_VERSION="$(curl -sL https://nodejs.org/dist/index.json 2>/dev/null \
    | python3 -c "import json,sys; d=json.load(sys.stdin); print(next(x['version'] for x in d if x['version'].startswith('v$NODE_MAJOR.')))" \
    2>/dev/null || true)"
  [ -n "${NODE_VERSION:-}" ] || NODE_VERSION="$NODE_FALLBACK"

  dest="$HOME/.local/node-${NODE_VERSION}-darwin-${NODE_ARCH}"
  if [ ! -d "$dest" ]; then
    say "downloading Node $NODE_VERSION ($NODE_ARCH)"
    tmp="$(mktemp -d)"
    tarball="node-${NODE_VERSION}-darwin-${NODE_ARCH}.tar.gz"
    curl -sL "https://nodejs.org/dist/${NODE_VERSION}/${tarball}" -o "$tmp/$tarball"
    tar -xzf "$tmp/$tarball" -C "$HOME/.local"
    rm -rf "$tmp"
  fi
  ln -sf "$dest/bin/node" "$LOCAL_BIN/node"
  ln -sf "$dest/bin/npm"  "$LOCAL_BIN/npm"
  ln -sf "$dest/bin/npx"  "$LOCAL_BIN/npx"
  ok "Node $("$LOCAL_BIN/node" --version) linked into $LOCAL_BIN"
fi

echo
say "Toolchain ready."
if ! printf '%s' ":$PATH:" | grep -q ":$LOCAL_BIN:"; then
  warn "$LOCAL_BIN is not on your PATH. Add to ~/.zshrc:"
  echo "      export PATH=\"\$HOME/.local/bin:\$PATH\""
fi
echo "    Then in a project:  make install && make run"
